{% extends "email-layout.html.twig" %}

{# Do not provide a "Open in browser" link #}
{% block browser %}{% endblock %}
{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your order confirmation Nº %ref%'|trans({'%ref%': order_ref}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{{ 'Thank you for your order!'|trans({}, 'email', locale) }}{% endblock %}

{# Content #}
{% block email_content %}
    {% for order in loop('order.invoice', 'order', {id: order_id, customer: '*'}) %}
        {% set orderCurrencyIsoCode = '' %}
        {% for cur in loop('currency.order', 'currency', {id: order.CURRENCY}) %}{% set orderCurrencyIsoCode = cur.ISOCODE %}{% endfor %}
        {% for cust in loop('customer.invoice', 'customer', {id: order.CUSTOMER, current: 0}) %}{% set customerRef = cust.REF %}{% endfor %}

        {{ hook('email-html.order-confirmation.before-address', {order: order_id}) }}

        {{ 'Here are the details of your purchase:'|trans({}, 'email', locale) }}<br /><br />

        <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td valign="top" width="55%">
                    <strong>{{ 'Delivery address:'|trans({}, 'email', locale) }}</strong><br>
                    {% set deliveryAddressHook = hook('email-html.order-confirmation.delivery-address', {module: order.DELIVERY_MODULE, order: order_id}) %}
                    {% if deliveryAddressHook is not empty %}
                        {{ deliveryAddressHook }}
                    {% else %}
                        {{ format_address(order.DELIVERY_ADDRESS, locale)|raw }}
                    {% endif %}
                </td>
                <td valign="top">
                    <strong>{{ 'Billing address:'|trans({}, 'email', locale) }}</strong><br />
                    {{ format_address(order.INVOICE_ADDRESS, locale)|raw }}
                </td>
            </tr>
        </table>

        {{ hook('email-html.order-confirmation.after-address', {order: order_id}) }}

        <br />

        <p>
            {{ 'Order Total:'|trans({}, 'email', locale) }} {{ format_money(order.TOTAL_TAXED_AMOUNT, order.CURRENCY) }}<br />
            {{ 'Order Number:'|trans({}, 'email', locale) }} {{ order.REF }}<br />
            {{ 'Paid With:'|trans({}, 'email', locale) }} {% for m in loop('payment-module', 'module', {id: order.PAYMENT_MODULE}) %}{{ m.TITLE }}{% endfor %}<br />
            {{ 'Purchase Date:'|trans({}, 'email', locale) }} {{ format_date(order.CREATE_DATE, 'datetime') }}<br />
            {{ 'Delivery method:'|trans({}, 'email', locale) }} {% for m in loop('delivery-module', 'module', {id: order.DELIVERY_MODULE}) %}{{ m.TITLE }}{% endfor %}<br />
        </p>

        {{ hook('email-html.order-confirmation.before-products', {order: order_id}) }}

        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size:13px;line-height:2em">
            <tr style="color:#999;font-size:11px">
                <td style="color:#999;border-bottom:1px solid #000">{{ 'What You Purchased'|trans({}, 'email', locale) }}</td>
                <td align="right" style="color:#999;border-bottom:1px solid #000">{{ 'Price in'|trans({}, 'email', locale) }} {{ orderCurrencyIsoCode }}</td>
            </tr>
            {% set subtotal = 0 %}
            {% for product in loop('order-products', 'order_product', {order: order.ID}) %}
                <tr>
                    <td style="border-bottom:1px solid #000">
                        <b>{{ product.TITLE }}</b> <i>({{ product.REF }}{% if product.REF != product.PRODUCT_SALE_ELEMENTS_REF %}, {{ product.PRODUCT_SALE_ELEMENTS_REF }}{% endif %})</i>
                        {% set combinations = loop('combinations', 'order_product_attribute_combination', {order_product: product.ID}) %}
                        {% if combinations %}<br />
                        {% for combination in combinations %}
                            <span style="color:#999;display:block;font-size:11px;line-height:1.2">* {{ combination.ATTRIBUTE_TITLE }}: {{ combination.ATTRIBUTE_AVAILABILITY_TITLE }}</span>
                        {% endfor %}
                        {% endif %}
                        {{ hook('email-html.order-confirmation.product-list', {order: order_id, order_product: product.ID}) }}
                    </td>
                    <td align="right" style="border-bottom:1px solid #000; white-space:nowrap">
                        {{ product.QUANTITY }} x {{ format_money(product.REAL_TAXED_PRICE, order.CURRENCY) }}
                        {# The loop already rounds the line the way the order was
                           totalled, and it picks the promotional amounts on its own.
                           Multiplying the unit price here instead reintroduced the
                           rounding the order does not use, and left the subtotal
                           and the total of the same email disagreeing. #}
                        {% set subtotal = subtotal + product.REAL_TOTAL_TAXED_PRICE %}
                    </td>
                </tr>

                {{ hook('email-html.order-confirmation.order-product', {order: order_id, order_product: product.ID}) }}

            {% endfor %}
            <tr>
                <td align="right" style="text-align:right">{{ 'Subtotal'|trans({}, 'email', locale) }}</td>
                <td align="right" style="text-align:right">{{ format_money(subtotal, order.CURRENCY) }} </td>
            </tr>
            {% if order.DISCOUNT > 0 %}
                <tr>
                    <td align="right" style="text-align:right">{{ 'Discount'|trans({}, 'email', locale) }}</td>
                    <td align="right" style="text-align:right">{{ format_money(order.DISCOUNT, order.CURRENCY) }} </td>
                </tr>
                <tr>
                    <td align="right" style="text-align:right">{{ 'Total'|trans({}, 'email', locale) }}</td>
                    <td align="right" style="text-align:right">{{ format_money(order.TOTAL_TAXED_AMOUNT - order.POSTAGE, order.CURRENCY) }} </td>
                </tr>
            {% endif %}
            <tr>
                <td align="right" style="text-align:right">{{ 'Shipping:'|trans({}, 'email', locale) }}</td>
                <td align="right" style="text-align:right">{{ format_money(order.POSTAGE, order.CURRENCY) }}</td>
            </tr>
            <tr>
                <td align="right" style="text-align:right"><strong>{{ 'Order Total'|trans({}, 'email', locale) }}</strong></td>
                <td align="right" style="text-align:right"><strong>{{ format_money(order.TOTAL_TAXED_AMOUNT, order.CURRENCY) }}</strong></td>
            </tr>
        </table>
    {% endfor %}

    {{ hook('email-html.order-confirmation.after-products', {order: order_id}) }}

    <br />

    {% set footerHook = hook('email-html.order-confirmation.footer', {order: order_id}) %}
    {% if footerHook is not empty %}
        {{ footerHook }}
    {% else %}
        <p><a href="{{ thelia_url('/account') }}">{{ 'View this order in your account at %shop_name%'|trans({'%shop_name%': config('store_name')}, 'email', locale) }}</a></p>

        <br />

        <h2>{{ 'Support'|trans({}, 'email', locale) }}</h2>
        {{ 'For any questions, or concerns, feel free to contact <a href="mailto:%mail%" style="color:#3c69c1;text-decoration:none" target="_blank">%mail%</a>.'|trans({'%mail%': config('store_email')}, 'email', locale)|raw }}<br /><br />
        <b>{{ 'Our contact us at:'|trans({}, 'email', locale) }}</b> <br />
        {{ config('store_name') }}<br>
        {{ config('store_address1') }}<br />
        {{ config('store_zipcode') }}, {{ config('store_city') }}<br />
        {% if config('store_country') %}
            {% for co in loop('store_country', 'country', {id: config('store_country')}) %}
                {{ co.TITLE }}
            {% endfor %}
        {% endif %}
        <br />
        <br />
        {{ 'Thanks'|trans({}, 'email', locale) }}<br />
    {% endif %}
{% endblock %}
