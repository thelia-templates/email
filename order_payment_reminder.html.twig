{% extends "email-layout.html.twig" %}

{#
    Sent by the reminder schedule of the shop (order:remind-unpaid) while an order waits
    for its payment.

    Expects:
      - order_ref:   the reference of the order
      - payment_url: the signed link that hands the order back to the payment step
#}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your order %ref% is waiting for its payment'|trans({'%ref%': order_ref}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />

    {{ 'Your order %ref% has been recorded, but we have not received its payment yet. Your basket is kept as it was: you can complete the payment in a few clicks.'|trans({'%ref%': order_ref}, 'email', locale) }}

    <br /><br />

    <p style="text-align:center">
        <a href="{{ payment_url }}" style="display:inline-block;padding:12px 24px;background-color:#3c69c1;color:#ffffff;text-decoration:none;border-radius:4px" target="_blank">{{ 'Complete the payment'|trans({}, 'email', locale) }}</a>
    </p>

    <p>
        {{ 'If you have already paid, or no longer wish to place this order, you can ignore this message.'|trans({}, 'email', locale) }}
    </p>

    <h2>{{ 'Support'|trans({}, 'email', locale) }}</h2>
    {{ 'For any questions, or concerns, feel free to contact <a href="mailto:%mail%" style="color:#3c69c1;text-decoration:none" target="_blank">%mail%</a>.'|trans({'%mail%': config('store_email')}, 'email', locale)|raw }}<br /><br />

    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
