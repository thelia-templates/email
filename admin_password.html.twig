{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your password for %store%'|trans({'%store%': config('store_name')}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {% set create_url = thelia_url('/admin/password-create/' ~ (token is defined ? token : '')) %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />
    {{ 'You have requested a new password for your administrator account at %store_name%'|trans({'%store_name%': config('store_name')}, 'email', locale) }}.<br /><br />
    {{ 'Please <a href="%url%">click here</a> to create a new password.'|trans({'%url%': create_url}, 'email', locale)|raw }}<br /><br />
    {{ 'You can also paste the URL below in you browser\'s address bar : <br><br>%url%<br><br>'|trans({'%url%': create_url}, 'email', locale)|raw }}<br /><br />
    {{ 'If you don\'t requested a new password, please ignore this message.'|trans({}, 'email', locale) }}.<br /><br />
    {{ 'Have a nice day'|trans({}, 'email', locale) }}
{% endblock %}
