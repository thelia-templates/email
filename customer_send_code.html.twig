{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Here your code for %store% account'|trans({'%store%': config('store_name')}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
{% for customer in loop('confirmation', 'customer', {current: false, id: customer_id}) %}
<p>{{ 'Welcome to %store%,'|trans({'%store%': config('store_name')}, 'email', locale) }}</p>
<p>{{ 'To complete your customer account creation, please confirm your account by copy/paste the code below.'|trans({}, 'email', locale) }}</p>
<p>{{ code|default('') }}</p>
<p>
    {{ 'Kind regards'|trans({}, 'email', locale) }},<br>
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
</p>
{% endfor %}
{% endblock %}
