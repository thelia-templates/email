{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your %store% account'|trans({'%store%': config('store_name')}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />
    {{ 'An account at %store_name% has been created by one of our managers.'|trans({'%store_name%': config('store_name')}, 'email', locale) }}.<br /><br />
    {% for cust in loop('cust_info', 'customer', {id: customer_id, current: false}) %}
        {{ 'To login, please use the email address <span style="font-family: courier, fixed; font-size: 120%">%email%</span>'|trans({'%email%': cust.EMAIL}, 'email', locale)|raw }}<br /><br />
    {% endfor %}
    {% if password is defined and password %}
        {{ 'Your password is <span style="font-family: courier, fixed; font-size: 120%">%pass%</span>'|trans({'%pass%': password}, 'email', locale)|raw }}<br /><br />
    {% endif %}
    {{ 'You can change your password and your account details at any time <a href="%url%">in our store</a>.'|trans({'%url%': thelia_url('/account')}, 'email', locale)|raw }}<br /><br />
    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
