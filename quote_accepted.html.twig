{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Quote %ref% accepted'|trans({'%ref%': quote_ref}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {{ '%customer% accepted quote %ref% (revision %revision%).'|trans({'%customer%': customer_name, '%ref%': quote_ref, '%revision%': revision_number}, 'email', locale) }}<br /><br />
    {{ 'The quote becomes an order when the payment is made.'|trans({}, 'email', locale) }}<br /><br />
    {% include 'quote_summary.html.twig' %}
    {% if admin_quote_path %}
        {% set admin_quote_url = thelia_url(admin_quote_path) %}
        {{ 'Open the quote in the back office:'|trans({}, 'email', locale) }}<br />
        <a href="{{ admin_quote_url }}">{{ admin_quote_url }}</a><br /><br />
    {% endif %}
    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
