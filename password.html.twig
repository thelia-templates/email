{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Reset your password on %store%'|trans({'%store%': config('store_name')}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {% set reset_url = thelia_url('/password/reset/%token', {token: token|default('')}) %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />
    {{ 'You asked to choose a new password for your account at %store_name%'|trans({'%store_name%': config('store_name')}, 'email', locale) }}.<br /><br />
    {{ 'Click the link below, or copy it in your browser address bar, to choose it.'|trans({}, 'email', locale) }}<br /><br />
    <a href="{{ reset_url }}">{{ reset_url }}</a><br /><br />
    {{ 'This link can only be used once, and stops working %minutes% minutes after this email was sent.'|trans({'%minutes%': tokenLifetimeInMinutes|default(60)}, 'email', locale) }}<br /><br />
    {{ 'If you did not ask for this, you can ignore this email: your password has not been changed.'|trans({}, 'email', locale) }}<br /><br />
    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
