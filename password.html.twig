{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your password for %store%'|trans({'%store%': config('store_name')}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />
    {{ 'You have requested a new password for your account at %store_name%'|trans({'%store_name%': config('store_name')}, 'email', locale) }}.<br /><br />
    {{ 'Your new password is <span style="font-family: courier, fixed; font-size: 120%">%pass%</span>'|trans({'%pass%': password|default('')}, 'email', locale)|raw }}<br /><br />
    {{ 'You can change your password in your user account by opening the "Change my password" link under your personal information'|trans({}, 'email', locale) }}.<br /><br />
    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
