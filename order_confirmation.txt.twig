{% for order in loop('order.invoice', 'order', {id: order_id, customer: '*'}) %}
{#- A group that shows its prices without tax: unit prices go out without tax, the recap is the one the order loop publishes. `is defined` keeps an older core on the taxed display. -#}
{%- set showUntaxed = order.CUSTOMER_GROUP_DISPLAY_TAXED_PRICE is defined and not order.CUSTOMER_GROUP_DISPLAY_TAXED_PRICE -%}
{{- 'Hello,'|trans({}, 'email', locale) }}

{{ 'Here is the details of your order %ref% placed on %date%'|trans({'%ref%': order.REF, '%date%': format_date(order.CREATE_DATE, 'datetime')}, 'email', locale) }}
{{ hook('email-txt.order-confirmation.before-address', {order: order_id}) }}
{{ 'Your delivery address'|trans({}, 'email', locale) }}
{%- set deliveryAddressHook = hook('email-txt.order-confirmation.delivery-address', {module: order.DELIVERY_MODULE, order: order_id}) %}
{% if deliveryAddressHook is not empty %}{{ deliveryAddressHook }}{% else %}{{ format_address(order.DELIVERY_ADDRESS, locale, false) }}{% endif %}

{{ 'Your billing address'|trans({}, 'email', locale) }}
{{ format_address(order.INVOICE_ADDRESS, locale, false) }}

{% if order.DELIVERY_DATE is defined and order.DELIVERY_DATE %}
{{ 'Requested delivery:'|trans({}, 'email', locale) }} {{ format_date(order.DELIVERY_DATE, 'date', null, locale) }}{% if order.DELIVERY_SLOT_START %} {{ 'from %start% to %end%'|trans({'%start%': order.DELIVERY_SLOT_START, '%end%': order.DELIVERY_SLOT_END}, 'email', locale) }}{% endif %}

{% endif %}
{{ hook('email-txt.order-confirmation.after-address', {order: order_id}) }}
{{ 'Items ordered:'|trans({}, 'email', locale) }}
{{ hook('email-txt.order-confirmation.before-products', {order: order_id}) }}
{% for product in loop('order-products', 'order_product', {order: order.ID}) %}
{%- if product.WAS_IN_PROMO == 1 %}{% set realTaxedPrice = product.TAXED_PROMO_PRICE %}{% else %}{% set realTaxedPrice = product.TAXED_PRICE %}{% endif %}
    {{ 'Item : %item%'|trans({'%item%': product.TITLE}, 'email', locale) }}
{%- set combinations = loop('combinations', 'order_product_attribute_combination', {order_product: product.ID}) %}
{% for combination in combinations %}    - {{ combination.ATTRIBUTE_TITLE }} - {{ combination.ATTRIBUTE_AVAILABILITY_TITLE }}
{% endfor -%}
{{ hook('email-txt.order-confirmation.product-list', {order: order_id, order_product: product.ID}) }}
    {{ 'Quantity : %qty%'|trans({'%qty%': product.QUANTITY}, 'email', locale) }}
    {{ showUntaxed ? 'Unit price excl. tax : %amount%'|trans({'%amount%': format_money(product.REAL_PRICE, order.CURRENCY)}, 'email', locale) : 'Unit price : %amount%'|trans({'%amount%': format_money(realTaxedPrice, order.CURRENCY)}, 'email', locale) }}
    {{ hook('email-txt.order-confirmation.order-product', {order: order_id, order_product: product.ID}) }}
{% endfor -%}
-----------------------------------------
{% if showUntaxed -%}
{{ 'Items total excl. tax : %amount%'|trans({'%amount%': format_money(order.TOTAL_ITEMS_AMOUNT, order.CURRENCY)}, 'email', locale) }}
{% if order.DISCOUNT > 0 -%}
{{ 'Discount excl. tax : %amount%'|trans({'%amount%': format_money(order.DISCOUNT_WITHOUT_TAX, order.CURRENCY)}, 'email', locale) }}
{{ 'Items after discount excl. tax : %amount%'|trans({'%amount%': format_money(order.TOTAL_AMOUNT_AFTER_DISCOUNT, order.CURRENCY)}, 'email', locale) }}
{% endif -%}
{{ 'Shipping excl. tax : %amount%'|trans({'%amount%': format_money(order.POSTAGE_UNTAXED, order.CURRENCY)}, 'email', locale) }}
{{ 'Total excl. tax : %amount%'|trans({'%amount%': format_money(order.TOTAL_AMOUNT, order.CURRENCY)}, 'email', locale) }}
{{ 'Tax : %amount%'|trans({'%amount%': format_money(order.TOTAL_TAX, order.CURRENCY)}, 'email', locale) }}
{{ 'Total incl. tax to pay : %amount%'|trans({'%amount%': format_money(order.TOTAL_TAXED_AMOUNT, order.CURRENCY)}, 'email', locale) }}
{% else -%}
{{ 'Items total : %amount%'|trans({'%amount%': format_money(order.TOTAL_TAXED_AMOUNT_AFTER_DISCOUNT, order.CURRENCY)}, 'email', locale) }}
{{ 'Shipping    : %amount%'|trans({'%amount%': format_money(order.POSTAGE, order.CURRENCY)}, 'email', locale) }}
{{ 'Total due   : %amount%'|trans({'%amount%': format_money(order.TOTAL_TAXED_AMOUNT, order.CURRENCY)}, 'email', locale) }}
{% endif -%}
==================================
{% if order.GIFT_MESSAGE|default('') %}
{{ 'Message for the recipient'|trans({}, 'email', locale) }}
{{ order.GIFT_MESSAGE }}
{% endif -%}
{{ hook('email-txt.order-confirmation.after-products', {order: order_id}) }}
{% if guest_order_tracking_url is defined %}{{ 'Follow your order at %url%'|trans({'%url%': guest_order_tracking_url}, 'email', locale) }}{% else %}{{ 'Your invoice is available in your customer account at %url%'|trans({'%url%': thelia_url('/account')}, 'email', locale) }}{% endif %}
{% endfor -%}
