{{ 'Hello,'|trans({}, 'email', locale) }}

{{ 'Your account at %store_name% has been changed by one of our managers.'|trans({'%store_name%': config('store_name')}, 'email', locale) }}.
{% for cust in loop('cust_info', 'customer', {id: customer_id, current: false}) %}
{{ 'To login, please use the email address <span style="font-family: courier, fixed; font-size: 120%">%email%</span>'|trans({'%email%': cust.EMAIL}, 'email', locale) }}
{%- endfor %}
{% if password is defined and password %}
{{ 'Your new password is <span style="font-family: courier, fixed; font-size: 120%">%pass%</span>'|trans({'%pass%': password}, 'email', locale) }}
{% endif %}
{{ 'You can change your password in your user account by opening the "Change my password" link under your personal information'|trans({}, 'email', locale) }}.

{{ 'Kind regards'|trans({}, 'email', locale) }},
{{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
