{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Report: %title%'|trans({'%title%': report_title}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{{ report_title }}{% endblock %}

{# Content #}
{% block email_content %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />

    <p>
        {{ 'Period: from %start% to %end%'|trans({'%start%': period_start, '%end%': period_end}, 'email', locale) }}<br />
        {{ 'Export: %export%'|trans({'%export%': export_title}, 'email', locale) }}
    </p>

    {% if is_empty %}
        <p>{{ 'Nothing to report for this period: no data, so no file is attached.'|trans({}, 'email', locale) }}</p>
    {% else %}
        {% if summary is not empty %}
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;margin:0 0 16px 0">
                {% for line in summary %}
                    <tr>
                        <td style="padding:8px 12px 8px 0;border-bottom:1px solid #e5e5e5;text-align:left">{{ line.label }}</td>
                        <td style="padding:8px 0 8px 12px;border-bottom:1px solid #e5e5e5;text-align:right;font-weight:bold;white-space:nowrap">{{ line.value }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if attachment_name is not empty %}
            <p>{{ 'The complete file is attached: %name%'|trans({'%name%': attachment_name}, 'email', locale) }}</p>
        {% elseif download_url is not empty %}
            <p><a href="{{ download_url }}" style="display:inline-block;padding:10px 20px;background-color:#3c69c1;color:#ffffff;text-decoration:none;border-radius:3px" target="_blank">{{ 'Download the report'|trans({}, 'email', locale) }}</a></p>
            {% if download_expires_at is not empty %}
                <p>{{ 'This link expires on %date%. It only works for this file.'|trans({'%date%': download_expires_at}, 'email', locale) }}</p>
            {% endif %}
        {% endif %}
    {% endif %}

    <br />

    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
