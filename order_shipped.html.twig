{% extends "email-layout.html.twig" %}

{# Open in browser #}
{% block browser %}{% endblock %}

{# No big image header #}
{% block image_header %}{% endblock %}

{# No pre-header #}
{% block pre_header %}{% endblock %}

{# Subject #}
{% block email_subject %}{{ 'Your order %ref% has been shipped'|trans({'%ref%': order_ref}, 'email', locale) }}{% endblock %}

{# Title #}
{% block email_title %}{% endblock %}

{# Content #}
{% block email_content %}
    {{ 'Hello,'|trans({}, 'email', locale) }}<br /><br />

    {{ 'Your order %ref% has been shipped and is on its way to you.'|trans({'%ref%': order_ref}, 'email', locale) }}<br /><br />

    {# The core passes each value only when it knows it: an order shipped without a
       tracking number, or by a carrier with no tracking page, still gets this mail. #}
    <p>
        {{ 'Order Number:'|trans({}, 'email', locale) }} {{ order_ref }}<br />
        {% if carrier is defined and carrier is not empty %}
            {{ 'Carrier:'|trans({}, 'email', locale) }} {{ carrier }}<br />
        {% endif %}
        {% if delivery_ref is defined and delivery_ref is not empty %}
            {{ 'Tracking number:'|trans({}, 'email', locale) }} {{ delivery_ref }}<br />
        {% endif %}
    </p>

    {% if tracking_url is defined and tracking_url is not empty %}
        <p><a href="{{ tracking_url }}" style="color:#3c69c1;text-decoration:none" target="_blank">{{ 'Track my parcel'|trans({}, 'email', locale) }}</a></p>
    {% endif %}

    <br />

    <h2>{{ 'Support'|trans({}, 'email', locale) }}</h2>
    {{ 'For any questions, or concerns, feel free to contact <a href="mailto:%mail%" style="color:#3c69c1;text-decoration:none" target="_blank">%mail%</a>.'|trans({'%mail%': config('store_email')}, 'email', locale)|raw }}<br /><br />

    {{ 'Kind regards'|trans({}, 'email', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'email', locale) }}
{% endblock %}
